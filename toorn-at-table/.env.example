# Copy to .env.local and fill in the real values. .env.local is gitignored.
#
# Without these the site still runs — it falls back to the static content
# in src/content/. Forms (newsletter, contact) will return a friendly
# "tijdelijk niet beschikbaar" message until both Supabase + Resend land.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Either the new-format publishable key (recommended) …
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# … or the legacy anon key — the app accepts both.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxx

# Server-only — never expose to the browser. Either of these works.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
# SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxx

# Resend (transactional email)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_ADDRESS="TOORN at table <hello@toornattable.com>"
NOTIFICATION_EMAIL=nick@toornattable.com

# Public site URL — used to build the newsletter confirmation links sent
# from server actions. Leave empty in development; the action falls back
# to the incoming request's host header.
NEXT_PUBLIC_SITE_URL=https://toornattable.com
