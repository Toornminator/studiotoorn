# Copy to .env.local and fill in the real values. .env.local is gitignored.
#
# Without these the site still runs — it falls back to the static content
# in src/content/. Forms (newsletter, contact) will return a friendly
# "tijdelijk niet beschikbaar" message until both Supabase + Resend land.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# Resend (transactional email)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_ADDRESS="TOORN at table <hello@toornattable.com>"
NOTIFICATION_EMAIL=nick@toornattable.com
